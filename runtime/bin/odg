#!/usr/bin/env bash
set -euo pipefail

MISSION="${1:-health}"

case "$MISSION" in
  health|dashboard)
    # Refresh the coherent Runtime state (runtime-state / status / queue / registry / scan) BEFORE
    # rendering so the read-only Dashboard always reflects the current repo state — never a stale or
    # empty runtime-state.json (Pipeline/Brain UNKNOWN) or a hard-coded SYSTEM_READY next mission.
    ./runtime/bin/odg-state.js >/dev/null
    ./runtime/bin/odg-health.js
    ;;
  state)
    ./runtime/bin/odg-state.js
    ;;
  mission)
    shift
    # Engineering missions (missionRequiresProvider === true) are driven through the EXISTING
    # RuntimeAutonomy + AutonomyRuntimeAdapter so the execute stage routes to the Claude Provider
    # Adapter. The single-mission driver decides: it exits 3 for any local / deterministic mission
    # (or one it can't route), and only then do we run the modern local fallback
    # (runtime/bin/odg-fallback.sh) — the exact relocation of the retired Mission-Standard engine,
    # proven byte-for-byte behaviour-equivalent — so local missions keep their existing behaviour.
    if node_modules/.bin/tsx src/runtime/mission-cli.ts "$@"; then
      exit 0
    else
      rc=$?
      if [ "$rc" -eq 3 ]; then
        ./runtime/bin/odg-fallback.sh "$@"
      else
        exit "$rc"
      fi
    fi
    ;;
  autonomy)
    # Mission Contract Factory: materialise any roadmap mission that has no contract yet BEFORE the
    # loop computes its work-list, so the campaign runs the full roadmap "from the roadmap alone".
    # Idempotent — a no-op once every roadmap mission already has an executable contract.
    ./runtime/bin/odg-generate-contracts.js >/dev/null
    # Refresh coherent state first so the queue/registry the loop and dashboard read are current,
    # then run the autonomy loop; refresh again afterwards so the Dashboard reflects any advance.
    ./runtime/bin/odg-state.js >/dev/null
    ./runtime/bin/odg-autonomy.js; rc=$?
    ./runtime/bin/odg-state.js >/dev/null || true
    exit "$rc"
    ;;
  delegate)
    # ODG Delegate Provider — ODG supervises Claude Code. Loads ONLY the target mission's contract,
    # emits a file-scoped Delegation Brief (Claude Code never sees the whole repo), then reuses the
    # existing verify → converge → Mission Ledger archive pipeline around the received patch.
    shift
    ./runtime/bin/odg-delegate.js "$@"
    ;;
  converge)
    # Convergence Orchestrator: one command drives the Runtime to convergence and emits a
    # campaign-level convergence report. Reuses the SAME state refresh discipline as `autonomy`
    # (the orchestrator itself front-loads contract generation via odg-generate-contracts.js).
    ./runtime/bin/odg-state.js >/dev/null
    ./runtime/bin/odg-converge.js; rc=$?
    ./runtime/bin/odg-state.js >/dev/null || true
    exit "$rc"
    ;;
  generate-contracts|contracts)
    # Mission Contract Factory: materialise every roadmap mission whose contract is missing so the
    # campaign can run "from the roadmap alone". Forwards flags (e.g. --dry-run).
    shift
    ./runtime/bin/odg-generate-contracts.js "$@"
    ;;
  verify)
    ./runtime/bin/odg-verify.js
    ;;
  status)
    ./runtime/bin/odg-state.js >/dev/null
    ./runtime/bin/odg-status.js
    ;;
  freeze)
    ./runtime/bin/odg-freeze.js
    ;;
  system-ready)
    # SYSTEM READY orchestrator — Mode Économie Maximale.
    # Pure orchestration of the EXISTING subcommands (verify → freeze → status). It duplicates no
    # logic, runs no global audit, and makes no network call: each step is literally the same
    # `odg <cmd>` a user runs by hand, re-invoked through "$0" so there stays a single source of
    # truth for every step's behaviour.
    # Fail-fast: the first step whose exit code is non-zero aborts the chain and that exact code is
    # returned to the caller; the remaining steps never run. Only when all three succeed is the
    # single final "SYSTEM READY" report emitted.
    "$0" verify || exit $?
    "$0" freeze || exit $?
    "$0" status || exit $?
    echo "======================================"
    echo "SYSTEM READY"
    echo "======================================"
    ;;
  *)
    echo "======================================"
    echo "ODG RUNTIME"
    echo "======================================"
    echo "Usage:"
    echo "  odg                 (health dashboard)"
    echo "  odg health"
    echo "  odg mission <NAME>"
    echo "  odg delegate <NAME> [--prepare-only]  (supervise Claude Code with a file-scoped brief)"
    echo "  odg generate-contracts [--dry-run]"
    echo "  odg autonomy"
    echo "  odg converge        (drive to convergence + report)"
    echo "  odg status"
    echo "  odg verify"
    echo "  odg freeze"
    echo "  odg system-ready    (verify -> freeze -> status, fail-fast)"
    exit 1
    ;;
esac
