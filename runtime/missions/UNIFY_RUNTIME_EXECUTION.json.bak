{
  "mission": "UNIFY_RUNTIME_EXECUTION",
  "priority": "CRITICAL",
  "mode": "ENGINEERING",
  "continue_until_complete": true,
  "description": "Faire de src/runtime le Runtime principal et réduire progressivement le fallback vers Mission Standard.",
  "objectives": [
    {
      "id": "OBJ-001",
      "priority": 1,
      "goal": "Faire de MissionOrchestrator le point d'entrée unique.",
      "done_when": [
        "Toutes les missions passent par MissionOrchestrator.",
        "Le Runtime choisit ensuite l'exécution locale ou Provider."
      ]
    },
    {
      "id": "OBJ-002",
      "priority": 2,
      "goal": "Intégrer les missions locales dans le Runtime TypeScript.",
      "done_when": [
        "mission-cli ne retourne plus EXIT_CODE=3 pour les missions supportées.",
        "Les missions locales sont exécutées par src/runtime."
      ]
    },
    {
      "id": "OBJ-003",
      "priority": 3,
      "goal": "Conserver le fallback uniquement pour les missions non migrées.",
      "done_when": [
        "Le fallback Mission Standard est limité aux missions restantes.",
        "Aucune régression fonctionnelle."
      ]
    },
    {
      "id": "OBJ-004",
      "priority": 4,
      "goal": "Produire un rapport de migration.",
      "done_when": [
        "Liste des missions migrées.",
        "Liste des missions restant à migrer."
      ]
    }
  ]
}