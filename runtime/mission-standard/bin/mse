#!/usr/bin/env bash
set -euo pipefail

MISSION="${1:-default}"
DATE=$(date -Iseconds)
COMMIT=$(git rev-parse --short HEAD)
BRANCH=$(git branch --show-current)

# Mission artifact directories the engine writes ITSELF in [4/5] GENERATE
# (passport, report, certificate, generated JSON, and the tracked history log).
# Single source of truth, shared by the pre-flight and the post-run governance
# check so both agree on exactly which paths are Runtime-owned outputs. Any path
# OUTSIDE these directories is real source/business work and must still block.
ARTIFACT_EXCLUDES=(
  ':(exclude)runtime/mission-standard/generated'
  ':(exclude)runtime/mission-standard/passports'
  ':(exclude)runtime/mission-standard/reports'
  ':(exclude)runtime/mission-standard/certificates'
  ':(exclude)runtime/mission-standard/history'
)

echo "======================================"
echo "MISSION STANDARD ENGINE v2"
echo "======================================"

echo "[1/5] PRE-FLIGHT"

case "$MISSION" in
  END_SESSION_*|AUDIT_*|READ_ONLY_*|S*)
    npx tsc --noEmit >/dev/null
    ;;
  *)
    npm run build >/dev/null
    npx tsc --noEmit >/dev/null
    ;;
esac

# Ignore ONLY the Runtime's own mission artifacts (written by a previous
# mission's [4/5] GENERATE step) so successive missions chain without manual
# cleanup. Uses the SAME exclusion set as the post-run governance check below,
# and the SAME `git diff` scope as before (tracked, unstaged modifications) —
# any change to a source or business file outside the artifact directories is
# still reported and still stops the pre-flight.
DIRTY_TRACKED=$(git diff --name-only -- "${ARTIFACT_EXCLUDES[@]}")
if [ -n "$DIRTY_TRACKED" ]; then
echo "STOP: Git repository is dirty"
echo
echo "Modified tracked files (outside mission artifacts):"
echo "$DIRTY_TRACKED"
echo
exit 1
fi


echo "[2/5] LOAD BRAIN"

BRAIN="runtime/brain/MASTER_PLAN.md"

if [ ! -f "$BRAIN" ]; then
  echo "STOP: Runtime Brain not found"
  exit 1
fi

echo "Brain loaded: $BRAIN"

echo "[BRAIN] Objectives:"
grep -E '^(MODE|MISSION:|NEXT_OBJECTIVES:|[0-9]+\.)' "$BRAIN" || true



echo "[3/5] INITIALIZE"

echo "[PIPELINE] Launching Runtime..."

node runtime/bin/odg-run.js "$MISSION"



mkdir -p runtime/mission-standard/{generated,passports,reports,certificates,history}

echo "[4/5] GENERATE"

# Derive the REAL verdict from the pipeline's evidence-based Validation Engine output rather than
# hardcoding SUCCESS. The pipeline's Validation Engine exits non-zero (halting odg-run.js, and this
# script under `set -e`) when the mission is not proven, so reaching this point already implies a
# validated mission — but the artifacts still reflect the actual, sourced status for traceability.
REPORT_STATUS=$(node -e "try{process.stdout.write(String(require('./runtime/generated/mission-report.json').status||'UNKNOWN'))}catch(e){process.stdout.write('UNKNOWN')}")
REPORT_VALIDATED=$(node -e "try{process.stdout.write(String(require('./runtime/generated/mission-report.json').validated===true))}catch(e){process.stdout.write('false')}")

if [ "$REPORT_VALIDATED" != "true" ] || [ "$REPORT_STATUS" != "SUCCESS" ]; then
  echo "STOP: mission not proven by the Validation Engine (status=${REPORT_STATUS}, validated=${REPORT_VALIDATED})."
  echo "No SUCCESS artifact will be written."
  exit 1
fi

cat > "runtime/mission-standard/passports/${MISSION}.passport.md" <<PASS
Mission : ${MISSION}
Date : ${DATE}
Status : ${REPORT_STATUS}
Validated : ${REPORT_VALIDATED}
PASS

cat > "runtime/mission-standard/reports/${MISSION}.report.md" <<REPORT
Mission : ${MISSION}
Status : ${REPORT_STATUS}
Validated : ${REPORT_VALIDATED}
REPORT

cat > "runtime/mission-standard/certificates/${MISSION}.certificate.md" <<CERT
Mission : ${MISSION}
Commit : ${COMMIT}
Branch : ${BRANCH}
Date : ${DATE}
Status : ${REPORT_STATUS}
CERT

printf -- "- [%s] %s %s\n" "$DATE" "$MISSION" "$REPORT_STATUS" >> runtime/mission-standard/history/history.md

cat > "runtime/mission-standard/generated/${MISSION}.json" <<JSON
{
  "mission":"${MISSION}",
  "status":"${REPORT_STATUS}",
  "validated":${REPORT_VALIDATED}
}
JSON

echo "[5/5] GOVERNANCE"

# The mission engine is DESIGNED to write its own artifacts in [4/5] GENERATE
# (passport, report, certificate, generated JSON, and the tracked history log).
# Governance therefore must not treat those expected outputs as tampering — it
# verifies only that nothing changed OUTSIDE the artifact directories, which is
# the real safety intent (catch stray edits to source made by the pipeline or
# build). This keeps the check deterministic and side-effect free.
UNEXPECTED_CHANGES=$(git status --porcelain -- "${ARTIFACT_EXCLUDES[@]}")

if [ -n "$UNEXPECTED_CHANGES" ]; then
  echo "STOP: Repository changed unexpectedly"
  echo
  echo "Changes outside mission artifact directories:"
  echo "$UNEXPECTED_CHANGES"
  echo
  exit 1
fi

echo "[6/6] COMPLETE"

echo "======================================"
echo "MISSION SUCCESS"
echo "======================================"
echo "Mission : ${MISSION}"
echo "======================================"
