# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ODG Runtime generated artifacts — never versioned; regenerated in-run and
# bootstrapped on cold start (see runtime/bin/odg-bootstrap.js).
/runtime/generated/

# ODG Runtime history ledger — regenerated on EVERY mission run (append-only),
# so tracking it permanently re-dirties the tree and pins the Release "gitClean"
# gate red (RootCauseEngine.isBookkeeping, src/runtime/root-cause-engine.ts).
# Same rationale as /runtime/generated/ above; the file stays on disk, untracked.
/runtime/mission-standard/history/

# ODG Runtime per-mission EVIDENCE — the Mission-Standard engine's [4/5] GENERATE
# outputs (passport, report, certificate, generated JSON). Rewritten on EVERY run
# with the current commit/branch/date (mse:117-146), so tracking them permanently
# re-dirties the tree — the exact churn the former `gitClean = true` hack masked
# in runtime/bin/odg-verify.js. The engine ALREADY excludes these paths from its
# governance gate (mse:22-30, ARTIFACT_EXCLUDES); the honest odg-verify gitClean
# check mirrors that. Same policy as /runtime/mission-standard/history/ above:
# preserved on disk (evidence), never versioned.
/runtime/mission-standard/generated/
/runtime/mission-standard/passports/
/runtime/mission-standard/reports/
/runtime/mission-standard/certificates/

# ODG Runtime security backups — kernel tarball + SHA-256 manifest emitted by the
# secure-backup subsystem. MUST be preserved on disk (disaster-recovery), but is
# binary/regenerated per run and must never be versioned. Kept on disk, untracked.
/runtime/security/

# ODG Runtime secure-backup RELEASE snapshots — a point-in-time kernel checksum +
# git-head/git-status capture written by the secure-backup subsystem (SECURE_*),
# distinct from the tracked engineering release records under runtime/releases/.
# Generated backup snapshots; preserved on disk, never versioned.
/runtime/releases/SECURE_*/

# ODG Runtime report ARCHIVES — timestamped snapshots of reports that already live
# (and stay tracked) under runtime/reports/. Regenerated on archival; not versioned.
/runtime/reports/archive/

# ODG Runtime generated mission CONTRACTS — the Mission Contract Factory / contract-
# on-demand synthesizer writes runtime/missions/<id>.json (generatedBy: "mission-
# contract-factory") for every roadmap AND on-demand mission it runs, so each run
# leaves untracked churn that permanently re-dirties the tree. odg-verify ALREADY
# excludes these by content stamp from its gitClean gate (odg-verify.js:38-52); this
# rule makes plain `git status` agree, giving every mission a deterministic clean
# finish. Regenerable on demand (re-synthesized from ROADMAP.json or mission intent);
# kept on disk for resume, never versioned. Contracts already tracked stay tracked
# (git honours the index over .gitignore) — the archived released contracts under
# runtime/missions/ are preserved. A NEW hand-authored contract must be added with
# `git add -f runtime/missions/<id>.json`.
/runtime/missions/*.json
/runtime/missions/*.evidence.md

# Ad-hoc scratch report output at the repo root (e.g. redirected command dumps).
# Not part of the Runtime tree; kept on disk if present, never versioned.
/rapport_complet.txt
