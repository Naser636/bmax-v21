        "src/parse-line.js": {
          "sha256": "bf3c72e83dc3599b1f8ad2147a2098fc6d288e9fdc9159b8ed6800c7d6f36dab",
          "code": "module.exports = function parseLine(line) {\n  const [sku, qty, price] = line.trim().split(',').map(field => field.trim());\n  const unitCents = Math.round(parseFloat(price) * 100);\n  return { sku, qty: parseInt(qty), unitCents };\n};"
        },
        "src/invoice-total.js": {
          "sha256": "bd8753311c7651f41b1e6ec0b8d974f5acf8c03f23c4681b01f3a2268756316c",
          "code": "module.exports = function invoiceTotal(items) {\n  return {\n    count: items.length,\n    totalCents: items.reduce((total, item) => total + item.qty * item.unitCents, 0)\n  };\n};"
        },
        "src/format-cents.js": {
          "sha256": "6e838520fb03a2d6c4821c2d5913c7314ddf4af765f28f1b70f0e8500efdd2dc",
          "code": "module.exports = function formatCents(cents) {\n  if (cents < 0) {\n    throw new Error(\"Cents must be a non-negative integer\");\n  }\n  const euros = Math.floor(cents / 100);\n  const centsPart = cents % 100;\n  return `${euros}.${centsPart.toString().padStart(2, '0')}`;\n};"
        }
      },
