# CANDIDATE — bounded auto-recovery, triggered by odg-preprod.service OnFailure (persistent crash-loop).
# Private/loopback only. Oneshot: swaps `current`→verified-good previous (no boot), restarts odg-preprod, confirms
# health on 127.0.0.1:3000. Hard attempt cap (ODG_RECOVER_MAX in a window) ⇒ no recovery loop. NO OnFailure here.
[Unit]
Description=ODG preprod bounded auto-recovery (rollback to last verified-good release)
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bmax-v21
Environment=ODG_REPO=/home/ubuntu/bmax-v21
Environment=ODG_RELEASE_ROOT=/home/ubuntu/odg-releases
Environment=ODG_RECOVER_PORT=3000
Environment=ODG_RECOVER_HOST=127.0.0.1
Environment=ODG_RECOVER_UNIT=odg-preprod.service
Environment=ODG_RECOVER_MAX=2
Environment=ODG_RECOVER_WINDOW=300
Environment=ODG_SYSTEMCTL=sudo systemctl
ExecStart=/bin/bash /home/ubuntu/bmax-v21/scripts/odg-recover.sh
