# PROPOSAL (V15) — NOT INSTALLED. Supersedes l1-fs-confinement.conf.proposed (systemd ProtectSystem/ProtectHome in a USER
# manager is fragile on this host: kernel.apparmor_restrict_unprivileged_userns=1). Confinement is instead provided by
# bubblewrap (own AppArmor profile bwrap-userns-restrict), via scripts/odg-resident-driver-confined.sh — tested end to end
# WITHOUT systemd by runtime/core/odg-resident-driver-confined.test.ts (rebuild / fresh / tsx-fallback / stop paths;
# three phases: trusted rebuild BEFORE the sandbox (freshness covers sources AND emitted dist .js); the tick confined with
# NO writable host path (runtime/dist, logs incl. its own trace, source, scripts, docs read-only; host Unix sockets
# unreachable; lo only; inherited fds > 2 closed; size-capped tmpfs; RLIMIT_FSIZE/NPROC; `timeout`, no orphan on launcher
# SIGKILL); then the TRUSTED launcher appends the trace line (strict format, launcher clock, TIMEOUT / truncated= markers).
#
# OWNER DRY-RUN REQUIRED BEFORE INSTALL (NOT reproduced here — no systemd was touched): if the base unit (or another drop-in)
# sets RestrictAddressFamilies=AF_UNIX, PrivateNetwork=, RestrictNamespaces=, NoNewPrivileges=/SystemCallFilter= or
# LockPersonality-style sandboxing, bwrap --unshare-all may FAIL: bringing up `lo` in the new network namespace needs an
# AF_NETLINK socket (RestrictAddressFamilies must then also list AF_NETLINK), and user/mount/pid namespaces must not be
# restricted. Dry-run: `systemd-run --user --wait --pipe -p <the unit's sandbox properties> bash scripts/odg-resident-driver-confined.sh`
# and check exit 0 + one new L0 line before installing.
#
# Owner install (user-systemd, no root): copy to ~/.config/systemd/user/odg-resident-driver.service.d/v15-confined-launcher.conf,
# `systemctl --user daemon-reload`, wait one tick: Result=success + a new L0 line. Rollback: delete the file + daemon-reload.
[Service]
ExecStart=
ExecStart=/bin/bash -lc 'bash scripts/odg-resident-driver-confined.sh'
# REQUIRED FOR INSTALL (still a proposal — owner to confirm the values from a measured tick; precompiled tick peaked
# ~71 MB RSS, tsx fallback ~113 MB): the launcher's rlimits + seccomp do NOT bound anonymous memory of the tsx fallback
# (no RLIMIT_AS there — its WebAssembly lexer reserves > 32 GiB virtual) nor kernel-side buffers; only the cgroup does.
# Needs the memory/pids controllers delegated to the user manager (check `systemctl --user show -p DelegateControllers`);
# without them these lines are silently ineffective — verify with `systemctl --user show odg-resident-driver -p MemoryMax`.
MemoryMax=512M
MemorySwapMax=0
TasksMax=256
TimeoutStartSec=120
